rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null &&
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.admin == true;
    }

    function getLugarPuntosMaximos(eventoId, lugarId) {
      let lugar = get(/databases/$(database)/documents/eventos/$(eventoId)/lugares/$(lugarId)).data;
      return lugar.puntos + lugar.puntosBonus;
    }

    match /usuarios/{uid} {
      allow read: if request.auth != null;

      // Permitir crear el perfil si no es admin, o si es el usuario mágico de revisión
      allow create: if request.auth != null && request.auth.uid == uid &&
                   (request.resource.data.admin == false || request.resource.data.nombre == "PlayStoreReviewUser1476");

      // Impedir que un usuario cambie su propio estatus de admin en las actualizaciones
      allow update: if request.auth != null && request.auth.uid == uid &&
                   (request.resource.data.admin == resource.data.admin || isAdmin());

      allow delete: if request.auth != null && (request.auth.uid == uid || isAdmin());
    }

    match /eventos/{eventoId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();

      match /lugares/{lugarId} {
        allow read: if request.auth != null;

        // Permitir a usuarios normales actualizar SOLO el campo primerVisitanteId si estaba vacío
        allow update: if request.auth != null && (
          isAdmin() ||
          (resource.data.get('primerVisitanteId', null) == null &&
           request.resource.data.primerVisitanteId == request.auth.uid &&
           request.resource.data.diff(resource.data).affectedKeys().hasOnly(['primerVisitanteId']))
        );

        allow create, delete: if isAdmin();
      }

      match /ranking/{usuarioId} {
        allow read: if request.auth != null;

        // Creación del propio documento de ranking: los puntos no superan los del lugar visitado
        allow create: if request.auth != null && (request.auth.uid == usuarioId || isAdmin()) &&
                     request.resource.data.keys().hasAll(['uid', 'nombre', 'puntosTotales', 'ultimaVisita', 'ultimoLugarId']) &&
                     request.resource.data.uid == usuarioId &&
                     request.resource.data.puntosTotales >= 0 &&
                     (isAdmin() || request.resource.data.puntosTotales <= getLugarPuntosMaximos(eventoId, request.resource.data.ultimoLugarId));

        // Actualización atómica de puntos propios: el incremento no puede superar los puntos (+bonus) del lugar dinámico
        allow update: if request.auth != null && (request.auth.uid == usuarioId || isAdmin()) &&
                     request.resource.data.uid == usuarioId &&
                     request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uid', 'nombre', 'puntosTotales', 'ultimaVisita', 'ultimoLugarId']) &&
                     (isAdmin() || (
                       request.resource.data.puntosTotales >= resource.data.puntosTotales &&
                       request.resource.data.puntosTotales - resource.data.puntosTotales <= getLugarPuntosMaximos(eventoId, request.resource.data.ultimoLugarId)
                     ));

        allow delete: if isAdmin() || (request.auth != null && request.auth.uid == usuarioId);
      }
    }

    match /visitas/{visitaId} {
      allow read: if request.auth != null;
      // Exigir que el ID del documento coincida con eventoId_lugarId_usuarioId
      allow create: if request.auth != null &&
                    request.resource.data.usuarioId == request.auth.uid &&
                    visitaId == request.resource.data.eventoId + '_' + request.resource.data.lugarId + '_' + request.auth.uid;
      // Permitir borrar visitas al admin o al propio dueño (para limpieza de anónimos)
      allow update, delete: if isAdmin() || (request.auth != null && resource.data.usuarioId == request.auth.uid);
    }
  }
}
