rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null &&
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.admin == true;
    }

    match /usuarios/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    match /eventos/{eventoId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();

      match /lugares/{lugarId} {
        allow read: if request.auth != null;
        allow write: if isAdmin();
      }
    }

    match /visitas/{visitaId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.usuarioId == request.auth.uid;
      // Permitir borrar visitas al admin o al propio dueño (para limpieza de anónimos)
      allow update, delete: if isAdmin() || (request.auth != null && resource.data.usuarioId == request.auth.uid);
    }
  }
}
